{
  "name": "littlehelper",
  "version": "0.1.0",
  "private": true,
  "description": "Hybrid documentation/help platform combining Git-hosted Markdown with PostgreSQL metadata",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive --if-present run test",
    "test:e2e": "pnpm --filter @littlehelper/api run test:e2e",
    "lint": "pnpm --recursive --if-present run lint",
    "lint:fix": "pnpm --recursive --if-present run lint:fix",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "pnpm --recursive run clean && rm -rf node_modules",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "prepare": "prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.10.0",
    "eslint": "^9.15.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prisma": "^5.7.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
