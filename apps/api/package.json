{
  "name": "@littlehelper/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server/server.js",
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build": "tsc",
    "start": "node dist/server/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:api": "newman run ../../tests/api/littlehelper.postman_collection.json -e ../../tests/api/newman.env.json || newman run ../../tests/api/littlehelper.postman_collection.json -e ../../tests/api/newman.env.example.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.0",
    "@aws-sdk/client-s3": "^3.712.0",
    "@aws-sdk/s3-request-presigner": "^3.712.0",
    "@fastify/static": "^7.0.0",
    "@littlehelper/shared": "workspace:*",
    "@prisma/client": "^5.7.0",
    "@octokit/app": "^15.1.1",
    "@google/generative-ai": "^0.19.0",
    "remark-parse": "^11.0.0",
    "fastify": "^4.26.0",
    "gray-matter": "^4.0.3",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.0",
    "simple-git": "^3.25.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@types/node": "^20.10.0",
    "newman": "^6.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0",
    "vitest": "^1.2.0"
  }
}
