{
  "name": "@littlehelper/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server/server.js",
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build": "tsc",
    "start": "node dist/server/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
